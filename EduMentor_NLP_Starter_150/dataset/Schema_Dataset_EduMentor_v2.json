{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EduMentor AI — Dataset NLP littérature v2",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "roman",
    "chapitre",
    "niveau",
    "split",
    "validation_status",
    "requires_teacher_review"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "record_type": {
      "enum": [
        "content_annotation",
        "vocabulary",
        "figure_de_style",
        "regional_exam_question"
      ]
    },
    "roman": {
      "type": "string"
    },
    "chapitre": {
      "type": "integer"
    },
    "niveau": {
      "enum": [
        "debutant",
        "intermediaire",
        "avance"
      ]
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test"
      ]
    },
    "synthetic": {
      "type": "boolean"
    },
    "requires_teacher_review": {
      "type": "boolean"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_status": {
      "type": "string"
    }
  },
  "additionalProperties": true
}